# Template for .env: copy to .env (`cp .env.example .env`) and replace every placeholder with real values.
# This file is committed, so it holds keys and fake values only.

# !!!    NEVER COMMIT .env to git or LEAK SECRETS into an Agent/Model's context  !!!

### -------------------------------
### --- ENVIRONMENTAL VARIABLES ---
### -------------------------------

# DB Admin (PostgreSQL)
# Used only by the postgres container on first start to create the database and admin user, and by db/init/ scripts. The MCP server never gets these.
POSTGRES_DB=mcp_enterprise
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change_me_admin_password

# DB MCP Server Login (PostgreSQL)
# Least-privilege role created by db/init/03_roles.sql: SELECT on employees, equipment, it_routing; INSERT on audit_logs. Host is the Compose service name, not localhost.
MCP_DB_USER=mcp_reader
MCP_DB_PASSWORD=change_me_mcp_reader_password
MCP_DB_HOST=postgres
MCP_DB_PORT=5432

# MCP Server
# Host of 0.0.0.0 binds to the container's network interface so Docker port mapping and other containers can reach it.
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Auth (JWT)
# Signing secret for HS256 tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_long_random_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=mcp-enterprise-integration-auth
JWT_AUDIENCE=mcp-enterprise-integration

# API (ServiceNow)
# Personal Developer Instance URL, no trailing slash: https://devXXXXX.service-now.com
SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com
SERVICENOW_USERNAME=change_me_servicenow_user
SERVICENOW_PASSWORD=change_me_servicenow_password

# Tunnel (Cloudflared)
# Token for a named tunnel from the Cloudflare dashboard; the cloudflared image reads TUNNEL_TOKEN.
TUNNEL_TOKEN=change_me_cloudflare_tunnel_token